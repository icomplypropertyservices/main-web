{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "memory": 1024,
      "maxDuration": 30,
      "excludeFiles": "{shopify-import/**,docs/**,website/pages/keywords/**,website/assets/images/keywords/**,website/data/keyword-enrichment/**,website/data/manufacturer-enrichment/**,website/bin/_*,**/.git/**,**/*.log,**/.DS_Store,**/Thumbs.db}"
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.icomplypropertyservices.co.uk" }],
      "destination": "https://icomplypropertyservices.co.uk/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "group.icomplypropertyservices.co.uk" }],
      "destination": "https://icomplypropertyservices.co.uk/:path*",
      "permanent": true
    },
    {
      "source": "/group",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/group/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/group/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "shop.icomplypropertyservices.co.uk" }],
      "destination": "https://icomplypropertyservices.co.uk/shop/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "shopweb.icomplypropertyservices.co.uk" }],
      "destination": "https://icomplypropertyservices.co.uk/shop/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "products.icomplypropertyservices.co.uk" }],
      "destination": "https://icomplypropertyservices.co.uk/products/:path*",
      "permanent": true
    },
    {
      "source": "/products",
      "destination": "/pages/packages",
      "permanent": true
    },
    {
      "source": "/products/",
      "destination": "/pages/packages",
      "permanent": true
    },
    {
      "source": "/products/:path*",
      "destination": "/pages/packages",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/shop/assets/(.*)", "destination": "/website/shop/assets/$1" },
    { "source": "/shop", "destination": "/website/shop/index.html" },
    { "source": "/shop/", "destination": "/website/shop/index.html" },
    { "source": "/shop/fire", "destination": "/website/shop/fire/index.html" },
    { "source": "/shop/fire/", "destination": "/website/shop/fire/index.html" },
    { "source": "/shop/electrical", "destination": "/website/shop/electrical/index.html" },
    { "source": "/shop/electrical/", "destination": "/website/shop/electrical/index.html" },
    { "source": "/shop/security", "destination": "/website/shop/security/index.html" },
    { "source": "/shop/security/", "destination": "/website/shop/security/index.html" },
    { "source": "/shop/gas", "destination": "/website/shop/gas/index.html" },
    { "source": "/shop/gas/", "destination": "/website/shop/gas/index.html" },
    { "source": "/assets/(.*)", "destination": "/website/assets/$1" },
    { "source": "/robots.txt", "destination": "/api/index.php" },
    { "source": "/sitemap.xml", "destination": "/api/index.php" },
    { "source": "/sitemap-:part.xml", "destination": "/api/index.php" },
    { "source": "/google-site-verification=:token.txt", "destination": "/google-site-verification=$1.txt" },
    { "source": "/favicon.ico", "destination": "/website/assets/images/og-image.jpg" },
    { "source": "/((?!assets|shop|robots.txt|sitemap|favicon.ico|google-site-verification).*)", "destination": "/api/index.php" }
  ],
  "headers": [
    {
      "source": "/sitemap(.*).xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
